{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smallframe.internal/schema/manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "description", "runtime", "state", "capabilities", "limits", "publisher", "files"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$", "minLength": 3, "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "maxLength": 240},
    "runtime": {"const": "smallframe-view/1"},
    "state": {"type": "object", "additionalProperties": false, "required": ["mode", "maxPlaintextBytes", "jsonSchema"], "properties": {"mode": {"enum": ["personal", "shared"]}, "maxPlaintextBytes": {"type": "integer", "minimum": 1, "maximum": 393216}, "publicTemplate": {}, "jsonSchema": {"type": "object"}}},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["clipboard.write", "export.download"]}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["maxViewNodes", "maxEventRate"], "properties": {"maxViewNodes": {"type": "integer", "minimum": 1, "maximum": 2000}, "maxEventRate": {"type": "integer", "minimum": 1, "maximum": 30}}},
    "publisher": {"type": "object", "additionalProperties": false, "required": ["displayName", "publicKey", "keyId"], "properties": {"displayName": {"type": "string", "minLength": 1, "maxLength": 80}, "publicKey": {"type": "string"}, "keyId": {"type": "string"}}},
    "files": {"type": "object", "additionalProperties": false, "required": ["app.worker.js"], "properties": {"app.worker.js": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": {"sha256": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 786432}}}}}
  }
}
